# Copy this file to .env.server and replace placeholders.
# One-time default admin (works in production too). Choose your own initial password.
# Requires 12–128 characters and a number. May be cleared after bootstrap completes.
RULELAB_DEFAULT_ADMIN_ENABLED=true
RULELAB_DEFAULT_ADMIN_EMAIL=admin@rulelab.local
RULELAB_DEFAULT_ADMIN_PASSWORD=

# Set to true only for a one-time auth-provider compatibility migration.
AUTH_IDENTITY_COMPAT_MIGRATION_ENABLED=false

# Mailgun is used only for password-reset delivery; signup and login send no email.
# Use MAILGUN_API_URL=https://api.eu.mailgun.net only when your Mailgun domain is in the EU region.
MAILGUN_API_KEY=replace_me
MAILGUN_DOMAIN=mg.example.com
# MAILGUN_API_URL=https://api.eu.mailgun.net

# Optional comma-separated signup email-domain controls.
# Allowlist wins over blocklist and disposable-email detection.
RULELAB_EMAIL_ALLOWLIST_DOMAINS=
RULELAB_EMAIL_BLOCKLIST_DOMAINS=

# Set to true only when the app is deployed behind a trusted proxy that controls X-Forwarded-For.
TRUST_PROXY_HEADERS=false
PUBLIC_API_MAX_CONCURRENT_LOCAL_TESTS=2

# Required whenever API keys are enabled. Generate with the command in README.md.
API_KEY_HASH_SECRET=
