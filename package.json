{
  "name": "rulelab",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "check:release": "npm run typecheck && npm run audit:prod",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate --workspaces=false",
    "patch:client-csp": "node scripts/patch-client-csp.mjs",
    "postinstall": "node src/server/build-local-test-worker.mjs"
  },
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "overrides": {
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "esbuild": "^0.28.1",
    "form-data": "4.0.6"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@monaco-editor/react": "^4.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "helmet": "^6.0.0",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.12.0",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp.sh/spec": "file:.wasp/spec",
    "shadcn": "^4.8.0",
    "prisma": "5.19.1",
    "typescript": "5.9.3",
    "vite": "^7.0.6",
    "vitest": "^4.0.16",
    "esbuild": "^0.28.1"
  },
  "description": "Open-source YARA-L 2.0 rule editor, validator, and local evaluator",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.14.1"
  }
}
